<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="KriyaID.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Kriya ID Admin Portal</title>

    <!-- Google Fonts: Playfair Display & Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 & Bootstrap Icons CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <!-- Kriya ID Stylesheet -->
    <link href="~/Content/css/site.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body style="background-color: var(--color-cream-light);">
    <form id="form1" runat="server">
        <div class="admin-layout">
            <!-- Sidebar -->
            <aside class="admin-sidebar">
                <div class="admin-sidebar-header">
                    <a href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>' class="brand-logo text-decoration-none" style="color: var(--color-cream); font-size: 1.5rem;">
                        <span>Kriya ID</span>
                        <span class="brand-badge" style="background-color: var(--color-beige); color: var(--color-deep-ocean-dark);">ADMIN</span>
                    </a>
                    <div class="mt-2 text-truncate" style="color: var(--color-beige); font-size: 0.8rem;">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        <asp:Literal ID="litAdminEmail" runat="server"></asp:Literal>
                    </div>
                </div>

                <nav class="flex-grow-1 py-3">
                    <a href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Categories.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-folder2"></i>
                        <span>Categories</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/SubCategories.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-diagram-3"></i>
                        <span>Sub-Categories</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Products.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-box-seam"></i>
                        <span>Products Catalog</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Orders.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-cart-check"></i>
                        <span>Orders</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Users.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Consultations.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-palette"></i>
                        <span>Consultations</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Reviews.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-star"></i>
                        <span>Reviews</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Banners.aspx") %>' class="admin-nav-item">
                        <i class="bi bi-images"></i>
                        <span>Hero Banners</span>
                    </a>
                </nav>

                <div class="p-3 border-top" style="border-color: rgba(238,232,223,0.12) !important;">
                    <a href='<%= ResolveUrl("~/Home.aspx") %>' target="_blank" class="admin-nav-item rounded px-3 py-2 mb-2" style="background: rgba(238,232,223,0.08);">
                        <i class="bi bi-box-arrow-up-right"></i>
                        <span>View Storefront</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Logout.aspx") %>' class="admin-nav-item rounded px-3 py-2 text-danger" style="background: rgba(155, 44, 44, 0.15);">
                        <i class="bi bi-power"></i>
                        <span>Sign Out</span>
                    </a>
                </div>
            </aside>

            <!-- Main Admin Content Area -->
            <div class="admin-content">
                <header class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--color-beige) !important;">
                    <div>
                        <h2 class="mb-0 fs-3"><asp:Literal ID="litPageTitle" runat="server"></asp:Literal></h2>
                        <small class="text-muted">Kriya ID Luxury Interior Atelier • Management Portal</small>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge rounded-pill px-3 py-2" style="background-color: var(--color-cream); color: var(--color-deep-ocean); border: 1px solid var(--color-beige); font-size: 0.85rem;">
                            <i class="bi bi-clock me-1"></i> <%= DateTime.Now.ToString("dd MMM yyyy") %>
                        </span>
                    </div>
                </header>

                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src='<%= ResolveUrl("~/Scripts/js/site.js") %>'></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
